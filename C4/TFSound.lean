theorem withR_rng (u : T) {t : Fin 4 → ℝ} (ht : Box4 t) : I.mem (poly u t) (rng (withR u I.zero true)) := by
  have h1 := prng_mem (withR u I.zero true) rfl ht
  rw [poly_withR] at h1
  unfold rng
  rw [withR_Req]
  have := I.mem_add h1 I.mem_zero
  rwa [add_zero] at this

