theorem cst_enc (n : ℤ) : Enc (fun _ => (n : ℝ)) (cst n) := by
  cases n with
  | ofNat j => exact mk_enc _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (fun _ => cstp_A j) (fun _ t _ => cstp_R j t)
