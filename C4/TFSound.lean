module

public import C4.TFCommon
public import C4.NumSound
public import C4Check.TF

@[expose] public section

/-!
# Soundness of the fixed-point Taylor models of `C4Check.TF`

`vp x = (x - 2^400) / 2^96` is the value of a point coefficient and `Box4 t` says `|t i| ≤ 1`.
For each model type (`TF.W4`, `TF.F4`, …) `Enc f u` says: if `u.ok = true`, then the statistics
field is the one of the coefficients, `Σ_k |c_k - Bp| ≤ A`, and `f t - poly u t ∈ u.R` on the box.
Every operation preserves `Enc` (`ops_sound`, an `OpsSound` of `C4.TFCommon`), so the evaluation of
a generic formula of `C4Check.Formulas2` at models encloses the formula at `ℝ`.

The generic part is the rounding lemma: when `|X - Bp| ≤ 2^170`, the coefficient `fin (Σ X_i Y_j)`
equals `Σ vp X_i · vp Y_j` up to `2^-97` (`fin_dot_spec`, `fin_sq_spec`).  The per-model parts
(polynomials, statistics, the per-degree product identities) are generated by a script.
-/

set_option exponentiation.threshold 1024
set_option Elab.async false

namespace C4

noncomputable section

namespace TF

/-- the value of a point coefficient -/
def vp (x : ℕ) : ℝ := ((x : ℝ) - 2 ^ 400) / 2 ^ 96

/-- the normalized box -/
def Box4 (t : Fin 4 → ℝ) : Prop := ∀ i, |t i| ≤ 1

/-- right-nested sums of products: the shape of the generated coefficient sums -/
def dotL : List (ℕ × ℕ) → ℕ
  | [] => 0
  | p :: ps => Nat.add (Nat.mul p.1 p.2) (dotL ps)

/-- the same sum of the centred values, in `ℤ` -/
def dotZ : List (ℕ × ℕ) → ℤ
  | [] => 0
  | p :: ps => ((p.1 : ℤ) - 2 ^ 400) * ((p.2 : ℤ) - 2 ^ 400) + dotZ ps

/-- the exact product coefficient -/
def dotR : List (ℕ × ℕ) → ℝ
  | [] => 0
  | p :: ps => vp p.1 * vp p.2 + dotR ps

/-! ## casts and point values -/

theorem cBp : ((Bp : ℕ) : ℝ) = 2 ^ 400 := by unfold Bp; rw [Nat.cast_pow, Nat.cast_ofNat]

theorem pabs_cast (x : ℕ) : ((pabs x : ℕ) : ℝ) = |(x : ℝ) - 2 ^ 400| := by
  unfold pabs Bp
  simp only [Nat.add_eq, Nat.sub_eq]
  rcases le_total (2 ^ 400) x with h | h
  · have h' : ((2 : ℝ) ^ 400) ≤ x := by exact_mod_cast h
    rw [Nat.sub_eq_zero_of_le h, Nat.add_zero, Nat.cast_sub h, abs_of_nonneg (by linarith)]
    push_cast; ring
  · have h' : (x : ℝ) ≤ 2 ^ 400 := by exact_mod_cast h
    rw [Nat.sub_eq_zero_of_le h, Nat.zero_add, Nat.cast_sub h, abs_of_nonpos (by linarith)]
    push_cast; ring

theorem pabs_int (x : ℕ) : ((pabs x : ℕ) : ℤ) = |(x : ℤ) - 2 ^ 400| := by
  have h := pabs_cast x
  have : ((|(x : ℤ) - 2 ^ 400| : ℤ) : ℝ) = |(x : ℝ) - 2 ^ 400| := by push_cast; ring_nf
  exact_mod_cast h.trans this.symm

theorem abs_vp (x : ℕ) : |vp x| = (pabs x : ℝ) / 2 ^ 96 := by
  rw [vp, abs_div, pabs_cast, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ 96)]

theorem vp_pq (c : ℕ) :
    vp c = (((Nat.sub c Bp : ℕ) : ℝ) - ((Nat.sub Bp c : ℕ) : ℝ)) / 2 ^ 96 := by
  unfold vp
  rw [← cBp]
  rcases le_total Bp c with h | h
  · rw [show Nat.sub Bp c = 0 from Nat.sub_eq_zero_of_le h, Nat.cast_zero, sub_zero,
      show Nat.sub c Bp = c - Bp from rfl, Nat.cast_sub h]
  · rw [show Nat.sub c Bp = 0 from Nat.sub_eq_zero_of_le h, Nat.cast_zero, zero_sub,
      show Nat.sub Bp c = Bp - c from rfl, Nat.cast_sub h]
    ring

theorem pabs_pq (c : ℕ) :
    ((pabs c : ℕ) : ℝ) = ((Nat.sub c Bp : ℕ) : ℝ) + ((Nat.sub Bp c : ℕ) : ℝ) := by
  unfold pabs; rw [Nat.add_eq, Nat.cast_add]

/-! ## the rounding lemma -/

theorem fin_spec (S : ℕ) (s : ℤ) (hS : (S : ℤ) ≡ s [ZMOD 2 ^ 400]) (hs : |s| ≤ 2 ^ 398) :
    ∃ ε : ℝ, |ε| ≤ 1 / 2 ^ 97 ∧ vp (fin S) = (s : ℝ) / 2 ^ 192 + ε := by
  obtain ⟨hs1, hs2⟩ := abs_le.mp hs
  have hl : Nat.land (Nat.add S K1) (2 ^ 400 - 1) = (S + K1) % 2 ^ 400 :=
    Nat.and_two_pow_sub_one_eq_mod (S + K1) 400
  have hsr : Nat.shiftRight ((S + K1) % 2 ^ 400) 96 = (S + K1) % 2 ^ 400 / 2 ^ 96 :=
    Nat.shiftRight_eq_div_pow _ 96
  have hfin : fin S = (S + K1) % 2 ^ 400 / 2 ^ 96 + K2 := by
    show Nat.add (Nat.shiftRight (Nat.land (Nat.add S K1) (2 ^ 400 - 1)) 96) K2 = _
    rw [hl, hsr]
    rfl
  have hK1 : ((K1 : ℕ) : ℤ) = 2 ^ 399 + 2 ^ 95 := by unfold K1; norm_cast
  have n1 : (2 : ℤ) ^ 398 + (2 ^ 399 + 2 ^ 95) < 2 ^ 400 := by norm_num
  have n2 : (0 : ℤ) ≤ -2 ^ 398 + (2 ^ 399 + 2 ^ 95) := by norm_num
  have h0 : 0 ≤ s + ((K1 : ℕ) : ℤ) := by rw [hK1]; linarith
  have hlt : s + ((K1 : ℕ) : ℤ) < 2 ^ 400 := by rw [hK1]; linarith
  have hmod : ((((S + K1) % 2 ^ 400 : ℕ)) : ℤ) = s + ((K1 : ℕ) : ℤ) := by
    rw [Int.natCast_mod, Nat.cast_add, Nat.cast_pow, Nat.cast_ofNat]
    have h1 := Int.ModEq.add_right ((K1 : ℕ) : ℤ) hS
    unfold Int.ModEq at h1
    rw [h1]
    exact Int.emod_eq_of_lt h0 hlt
  have hq : (((S + K1) % 2 ^ 400 / 2 ^ 96 : ℕ) : ℤ) = (s + 2 ^ 95) / 2 ^ 96 + 2 ^ 303 := by
    rw [Int.natCast_div, hmod, Nat.cast_pow, Nat.cast_ofNat, hK1]
    rw [show s + (2 ^ 399 + 2 ^ 95) = (s + 2 ^ 95) + 2 ^ 303 * 2 ^ 96 by ring,
      Int.add_mul_ediv_right _ _ (by positivity)]
  have hK2 : ((K2 : ℕ) : ℝ) = 2 ^ 400 - 2 ^ 303 := by
    unfold K2
    rw [Nat.cast_sub (by norm_num)]
    push_cast
    ring
  set q' : ℤ := (s + 2 ^ 95) / 2 ^ 96 with hq'
  have h1 : q' * 2 ^ 96 ≤ s + 2 ^ 95 := Int.ediv_mul_le _ (by positivity)
  have h2 : s + 2 ^ 95 < (q' + 1) * 2 ^ 96 := Int.lt_ediv_add_one_mul_self _ (by positivity)
  have hv : vp (fin S) = (q' : ℝ) / 2 ^ 96 := by
    rw [vp, hfin, Nat.cast_add, hK2]
    have e : ((((S + K1) % 2 ^ 400 / 2 ^ 96 : ℕ)) : ℝ) =
        ((((S + K1) % 2 ^ 400 / 2 ^ 96 : ℕ) : ℤ) : ℝ) := by norm_cast
    rw [e, hq]
    push_cast
    ring
  refine ⟨(q' : ℝ) / 2 ^ 96 - (s : ℝ) / 2 ^ 192, ?_, by rw [hv]; ring⟩
  have h1' : (q' : ℝ) * 2 ^ 96 ≤ s + 2 ^ 95 := by exact_mod_cast h1
  have h2' : (s : ℝ) + 2 ^ 95 < (q' + 1) * 2 ^ 96 := by exact_mod_cast h2
  have e : (q' : ℝ) / 2 ^ 96 - (s : ℝ) / 2 ^ 192 = ((q' : ℝ) * 2 ^ 96 - s) / 2 ^ 192 := by
    have h192 : (2 : ℝ) ^ 192 = 2 ^ 96 * 2 ^ 96 := by norm_num
    rw [h192, sub_div, mul_div_mul_right _ _ (by positivity : (2 : ℝ) ^ 96 ≠ 0)]
  have hX : |(q' : ℝ) * 2 ^ 96 - s| ≤ 2 ^ 95 := by
    rw [abs_le]; constructor <;> linarith
  rw [e, abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ 192)]
  calc |(q' : ℝ) * 2 ^ 96 - s| / 2 ^ 192 ≤ 2 ^ 95 / 2 ^ 192 := by gcongr
    _ = 1 / 2 ^ 97 := by norm_num

theorem dotL_modeq : ∀ ps : List (ℕ × ℕ), ((dotL ps : ℕ) : ℤ) ≡ dotZ ps [ZMOD 2 ^ 400]
  | [] => by rw [dotL, dotZ, Nat.cast_zero]
  | p :: ps => by
    have ih := dotL_modeq ps
    rw [dotL, dotZ, Nat.add_eq, Nat.mul_eq, Nat.cast_add, Nat.cast_mul]
    refine Int.ModEq.add ?_ ih
    apply Int.ModEq.symm
    rw [Int.modEq_iff_dvd]
    exact ⟨(p.1 : ℤ) + p.2 - 2 ^ 400, by ring⟩

theorem dotR_eq : ∀ ps : List (ℕ × ℕ), dotR ps = (dotZ ps : ℝ) / 2 ^ 192
  | [] => by rw [dotR, dotZ, Int.cast_zero, zero_div]
  | p :: ps => by
    rw [dotR, dotZ, dotR_eq ps]
    push_cast
    unfold vp
    ring

theorem dotZ_bound : ∀ ps : List (ℕ × ℕ), (∀ p ∈ ps, pabs p.1 ≤ LIM ∧ pabs p.2 ≤ LIM) →
    |dotZ ps| ≤ ps.length * (2 ^ 170 * 2 ^ 170)
  | [], _ => by rw [dotZ, abs_zero, List.length_nil, Nat.cast_zero, zero_mul]
  | p :: ps, h => by
    have ih := dotZ_bound ps fun q hq => h q (List.mem_cons_of_mem _ hq)
    obtain ⟨h1, h2⟩ := h p List.mem_cons_self
    have a1 : |(p.1 : ℤ) - 2 ^ 400| ≤ 2 ^ 170 := by
      rw [← pabs_int]; exact_mod_cast (show pabs p.1 ≤ 2 ^ 170 from h1)
    have a2 : |(p.2 : ℤ) - 2 ^ 400| ≤ 2 ^ 170 := by
      rw [← pabs_int]; exact_mod_cast (show pabs p.2 ≤ 2 ^ 170 from h2)
    have hm : |((p.1 : ℤ) - 2 ^ 400) * ((p.2 : ℤ) - 2 ^ 400)| ≤ 2 ^ 170 * 2 ^ 170 := by
      rw [abs_mul]; exact mul_le_mul a1 a2 (abs_nonneg _) (by positivity)
    simp only [dotZ, List.length_cons]
    push_cast
    calc |((p.1 : ℤ) - 2 ^ 400) * ((p.2 : ℤ) - 2 ^ 400) + dotZ ps|
        ≤ |((p.1 : ℤ) - 2 ^ 400) * ((p.2 : ℤ) - 2 ^ 400)| + |dotZ ps| := abs_add_le _ _
      _ ≤ _ := by linarith

/-- the rounding lemma for a product coefficient -/
theorem fin_dot_spec (ps : List (ℕ × ℕ)) (hb : ∀ p ∈ ps, pabs p.1 ≤ LIM ∧ pabs p.2 ≤ LIM)
    (hl : ps.length ≤ 256) :
    ∃ ε : ℝ, |ε| ≤ 1 / 2 ^ 97 ∧ vp (fin (dotL ps)) = dotR ps + ε := by
  have hz := dotZ_bound ps hb
  have hl' : ((ps.length : ℕ) : ℤ) ≤ 256 := by exact_mod_cast hl
  obtain ⟨ε, hε, e⟩ := fin_spec (dotL ps) (dotZ ps) (dotL_modeq ps) (by
    calc |dotZ ps| ≤ ps.length * (2 ^ 170 * 2 ^ 170) := hz
      _ ≤ 256 * (2 ^ 170 * 2 ^ 170) := by gcongr
      _ ≤ 2 ^ 398 := by norm_num)
  exact ⟨ε, hε, by rw [e, dotR_eq]⟩

/-- the rounding lemma for a square coefficient (off-diagonal products counted twice) -/
theorem fin_sq_spec (off dia : List (ℕ × ℕ)) (hb1 : ∀ p ∈ off, pabs p.1 ≤ LIM ∧ pabs p.2 ≤ LIM)
    (hb2 : ∀ p ∈ dia, pabs p.1 ≤ LIM ∧ pabs p.2 ≤ LIM) (hl1 : off.length ≤ 256)
    (hl2 : dia.length ≤ 256) :
    ∃ ε : ℝ, |ε| ≤ 1 / 2 ^ 97 ∧
      vp (fin (Nat.add (Nat.shiftLeft (dotL off) 1) (dotL dia))) = 2 * dotR off + dotR dia + ε := by
  have hz1 := dotZ_bound off hb1
  have hz2 := dotZ_bound dia hb2
  have hl1' : ((off.length : ℕ) : ℤ) ≤ 256 := by exact_mod_cast hl1
  have hl2' : ((dia.length : ℕ) : ℤ) ≤ 256 := by exact_mod_cast hl2
  have hm : (((Nat.add (Nat.shiftLeft (dotL off) 1) (dotL dia)) : ℕ) : ℤ) ≡
      2 * dotZ off + dotZ dia [ZMOD 2 ^ 400] := by
    have hsl : Nat.shiftLeft (dotL off) 1 = dotL off * 2 := by
      rw [show Nat.shiftLeft (dotL off) 1 = dotL off <<< 1 from rfl, Nat.shiftLeft_eq, pow_one]
    rw [Nat.add_eq, hsl]
    push_cast
    exact Int.ModEq.add (by rw [mul_comm]; exact Int.ModEq.mul_left _ (dotL_modeq off))
      (dotL_modeq dia)
  obtain ⟨ε, hε, e⟩ := fin_spec _ (2 * dotZ off + dotZ dia) hm (by
    have b1 : |dotZ off| ≤ 256 * (2 ^ 170 * 2 ^ 170) :=
      le_trans hz1 (mul_le_mul_of_nonneg_right hl1' (by positivity))
    have b2 : |dotZ dia| ≤ 256 * (2 ^ 170 * 2 ^ 170) :=
      le_trans hz2 (mul_le_mul_of_nonneg_right hl2' (by positivity))
    have b3 : (2 : ℤ) * (256 * (2 ^ 170 * 2 ^ 170)) + 256 * (2 ^ 170 * 2 ^ 170) ≤ 2 ^ 398 := by
      norm_num
    calc |2 * dotZ off + dotZ dia| ≤ |2 * dotZ off| + |dotZ dia| := abs_add_le _ _
      _ = 2 * |dotZ off| + |dotZ dia| := by rw [abs_mul, abs_two]
      _ ≤ 2 ^ 398 := by linarith)
  exact ⟨ε, hε, by rw [e, dotR_eq, dotR_eq]; push_cast; ring⟩

/-- `|dotR ps| ≤ |ps| U V / 2^192` when every factor is within `U`, `V` of `Bp` -/
theorem dotR_bound (U V : ℕ) : ∀ ps : List (ℕ × ℕ), (∀ p ∈ ps, pabs p.1 ≤ U ∧ pabs p.2 ≤ V) →
    |dotR ps| ≤ ps.length * ((U : ℝ) / 2 ^ 96 * ((V : ℝ) / 2 ^ 96))
  | [], _ => by rw [dotR, abs_zero, List.length_nil, Nat.cast_zero, zero_mul]
  | p :: ps, h => by
    have ih := dotR_bound U V ps fun q hq => h q (List.mem_cons_of_mem _ hq)
    obtain ⟨h1, h2⟩ := h p List.mem_cons_self
    have a1 : |vp p.1| ≤ (U : ℝ) / 2 ^ 96 := by
      rw [abs_vp]; gcongr
    have a2 : |vp p.2| ≤ (V : ℝ) / 2 ^ 96 := by
      rw [abs_vp]; gcongr
    have hm : |vp p.1 * vp p.2| ≤ (U : ℝ) / 2 ^ 96 * ((V : ℝ) / 2 ^ 96) := by
      rw [abs_mul]; exact mul_le_mul a1 a2 (abs_nonneg _) (by positivity)
    simp only [dotR, List.length_cons]
    push_cast
    calc |vp p.1 * vp p.2 + dotR ps| ≤ |vp p.1 * vp p.2| + |dotR ps| := abs_add_le _ _
      _ ≤ _ := by linarith

/-- the size of a rounded coefficient -/
theorem pabs_le_of_vp {x : ℕ} {d ε B : ℝ} (hv : vp x = d + ε) (hε : |ε| ≤ 1 / 2 ^ 97)
    (hd : |d| ≤ B) : (pabs x : ℝ) ≤ 2 ^ 96 * B + 1 / 2 := by
  have h := abs_vp x
  rw [hv] at h
  have : |d + ε| ≤ B + 1 / 2 ^ 97 := (abs_add_le _ _).trans (by linarith)
  have h' : (pabs x : ℝ) = 2 ^ 96 * |d + ε| := by rw [h]; field_simp
  rw [h']
  nlinarith

/-! ## monomials on the box -/

theorem abs_mul_le_one {a b : ℝ} (ha : |a| ≤ 1) (hb : |b| ≤ 1) : |a * b| ≤ 1 := by
  rw [abs_mul]
  calc |a| * |b| ≤ 1 * 1 := mul_le_mul ha hb (abs_nonneg _) zero_le_one
    _ = 1 := one_mul 1

theorem abs_pow_le_one {a : ℝ} (ha : |a| ≤ 1) (n : ℕ) : |a ^ n| ≤ 1 := by
  rw [abs_pow]; exact pow_le_one₀ (abs_nonneg _) ha

theorem term_le {c m : ℝ} (hm : |m| ≤ 1) : |c * m| ≤ |c| := by
  rw [abs_mul]; exact mul_le_of_le_one_right (abs_nonneg _) hm

/-- an odd term: `|vp c · m| ≤ pabs c / 2^96` -/
theorem odd_term (c : ℕ) {m : ℝ} (hm : |m| ≤ 1) :
    -(((Nat.sub c Bp : ℕ) : ℝ) + ((Nat.sub Bp c : ℕ) : ℝ)) / 2 ^ 96 ≤ vp c * m ∧
      vp c * m ≤ (((Nat.sub c Bp : ℕ) : ℝ) + ((Nat.sub Bp c : ℕ) : ℝ)) / 2 ^ 96 := by
  have h := term_le (c := vp c) hm
  rw [abs_vp, pabs_pq] at h
  obtain ⟨h1, h2⟩ := abs_le.mp h
  constructor <;> linarith [show -(((Nat.sub c Bp : ℕ) : ℝ) + ((Nat.sub Bp c : ℕ) : ℝ)) / 2 ^ 96 =
    -((((Nat.sub c Bp : ℕ) : ℝ) + ((Nat.sub Bp c : ℕ) : ℝ)) / 2 ^ 96) by ring]

/-- an even term (`0 ≤ m ≤ 1`): `-q ≤ vp c · m · 2^96 ≤ p` -/
theorem even_term (c : ℕ) {m : ℝ} (h0 : 0 ≤ m) (h1 : m ≤ 1) :
    -(((Nat.sub Bp c : ℕ) : ℝ) / 2 ^ 96) ≤ vp c * m ∧ vp c * m ≤ ((Nat.sub c Bp : ℕ) : ℝ) / 2 ^ 96 := by
  rw [vp_pq]
  have hp : (0 : ℝ) ≤ ((Nat.sub c Bp : ℕ) : ℝ) := Nat.cast_nonneg _
  have hq : (0 : ℝ) ≤ ((Nat.sub Bp c : ℕ) : ℝ) := Nat.cast_nonneg _
  constructor
  · rw [neg_le, ← neg_mul, ← neg_div, neg_sub, div_mul_eq_mul_div, div_le_div_iff_of_pos_right
      (by positivity)]
    nlinarith
  · rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right (by positivity)]
    nlinarith

/-- the symmetric interval `[-E, E]` (offset `E`) -/
theorem mem_sym {x : ℝ} {E : ℕ} (h : |x| ≤ (E : ℝ) / 2 ^ 96) : I.mem x ⟨Nat.add Bb E, Nat.add Bb E⟩ := by
  obtain ⟨h1, h2⟩ := abs_le.mp h
  refine ⟨?_, ?_⟩ <;> rw [val_addB'] <;> linarith


/-! ## exact point operations -/

theorem LIMA_lt_Bp : LIMA < Bp := by unfold LIMA Bp; norm_num

theorem Bp2_eq : Bp2 = Bp + Bp := by unfold Bp2 Bp; norm_num

theorem vp_Bp : vp Bp = 0 := by unfold vp; rw [cBp]; ring

theorem pabs_Bp : pabs Bp = 0 := by unfold pabs; simp only [Nat.add_eq, Nat.sub_eq, Nat.sub_self]

theorem vp_add {x y : ℕ} (h : Bp ≤ x + y) : vp (Nat.sub (Nat.add x y) Bp) = vp x + vp y := by
  unfold vp
  rw [show Nat.sub (Nat.add x y) Bp = x + y - Bp from rfl, Nat.cast_sub h, Nat.cast_add, cBp]
  ring

theorem vp_sub {x y : ℕ} (h : y ≤ x + Bp) : vp (Nat.sub (Nat.add x Bp) y) = vp x - vp y := by
  unfold vp
  rw [show Nat.sub (Nat.add x Bp) y = x + Bp - y from rfl, Nat.cast_sub h, Nat.cast_add, cBp]
  ring

theorem vp_neg {x : ℕ} (h : x ≤ Bp2) : vp (Nat.sub Bp2 x) = -vp x := by
  unfold vp
  rw [show Nat.sub Bp2 x = Bp2 - x from rfl, Nat.cast_sub h, Bp2_eq, Nat.cast_add, cBp]
  ring

theorem add_ok {x y A B : ℕ} (hx : pabs x ≤ A) (hy : pabs y ≤ B) (h : A + B ≤ LIMA) :
    Bp ≤ x + y := by
  have := LIMA_lt_Bp
  unfold pabs at hx hy
  simp only [Nat.add_eq, Nat.sub_eq] at hx hy
  omega

theorem sub_ok {x y A B : ℕ} (hx : pabs x ≤ A) (hy : pabs y ≤ B) (h : A + B ≤ LIMA) :
    y ≤ x + Bp := by
  have := LIMA_lt_Bp
  unfold pabs at hx hy
  simp only [Nat.add_eq, Nat.sub_eq] at hx hy
  omega

theorem neg_ok {x A : ℕ} (hx : pabs x ≤ A) (h : A ≤ LIMA) : x ≤ Bp2 := by
  have := LIMA_lt_Bp
  have := Bp2_eq
  unfold pabs at hx
  simp only [Nat.add_eq, Nat.sub_eq] at hx
  omega

theorem pabs_add_le {x y : ℕ} (h : Bp ≤ x + y) :
    pabs (Nat.sub (Nat.add x y) Bp) ≤ pabs x + pabs y := by
  unfold pabs
  simp only [Nat.add_eq, Nat.sub_eq]
  omega

theorem pabs_sub_le {x y : ℕ} (h : y ≤ x + Bp) :
    pabs (Nat.sub (Nat.add x Bp) y) ≤ pabs x + pabs y := by
  unfold pabs
  simp only [Nat.add_eq, Nat.sub_eq]
  omega

theorem pabs_neg {x : ℕ} (h : x ≤ Bp2) : pabs (Nat.sub Bp2 x) = pabs x := by
  have := Bp2_eq
  unfold pabs
  simp only [Nat.add_eq, Nat.sub_eq]
  omega

theorem cBpB : ((BpB : ℕ) : ℝ) = 2 ^ 400 + 2 ^ 256 := by
  unfold BpB; rw [Nat.cast_add, Nat.cast_pow, Nat.cast_pow, Nat.cast_ofNat]

theorem cBb' : ((Bb : ℕ) : ℝ) = 2 ^ 256 := cBb

/-- `val (a - b) ≥ (a - b - 2^256)/2^96` (truncation only raises it) -/
theorem val_sub_ge (a b : ℕ) : ((a : ℝ) - b - 2 ^ 256) / 2 ^ 96 ≤ val (Nat.sub a b) := by
  unfold val
  have := sub_le_cast a b
  gcongr

theorem abs_prod_le {a b A B : ℝ} (ha : |a| ≤ A) (hb : |b| ≤ B) : |a * b| ≤ A * B := by
  rw [abs_mul]
  exact mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)

/-- an offset bound of an interval -/
theorem abs_le_rmag {v : ℝ} {A : I} (h : I.mem v A) : |v| ≤ (rmag A : ℝ) / 2 ^ 96 := by
  obtain ⟨h1, h2⟩ := h
  have s1 := sub_le_cast A.L Bb
  have s2 := sub_le_cast A.H Bb
  rw [cBb] at s1 s2
  have m1 : ((Nat.sub A.L Bb : ℕ) : ℝ) ≤ (rmag A : ℝ) := by
    unfold rmag; rw [mx_eq]; exact_mod_cast le_max_left _ _
  have m2 : ((Nat.sub A.H Bb : ℕ) : ℝ) ≤ (rmag A : ℝ) := by
    unfold rmag; rw [mx_eq]; exact_mod_cast le_max_right _ _
  unfold val at h1 h2
  rw [abs_le]
  constructor
  · have : ((A.L : ℝ) - 2 ^ 256) / 2 ^ 96 ≤ (rmag A : ℝ) / 2 ^ 96 := by gcongr; linarith
    linarith
  · have : ((A.H : ℝ) - 2 ^ 256) / 2 ^ 96 ≤ (rmag A : ℝ) / 2 ^ 96 := by gcongr; linarith
    linarith

/-! ## atoms instead of numerals -/

theorem vp_eq (x : ℕ) : vp x = ((x : ℝ) - (Bp : ℝ)) / 2 ^ 96 := by rw [vp, cBp]

theorem cBpB' : ((BpB : ℕ) : ℝ) = (Bp : ℝ) + (Bb : ℝ) := by rw [cBpB, cBp, cBb]

theorem val_sub_ge' (a b : ℕ) : ((a : ℝ) - b - (Bb : ℝ)) / 2 ^ 96 ≤ val (Nat.sub a b) := by
  rw [cBb]; exact val_sub_ge a b

theorem cDB : ((DB : ℕ) : ℝ) = (Bp : ℝ) - (Bb : ℝ) := by
  unfold DB Bp Bb
  rw [Nat.cast_sub (by norm_num)]

theorem vp_addDB (x : ℕ) : vp (Nat.add x DB) = val x := by
  rw [vp_eq, Nat.add_eq, Nat.cast_add, cDB]
  unfold val
  rw [cBb]
  ring

theorem pabs_addDB (x : ℕ) : pabs (Nat.add x DB) = Nat.add (Nat.sub x Bb) (Nat.sub Bb x) := by
  have h1 : DB + Bb = Bp := by unfold DB Bp Bb; norm_num
  unfold pabs
  simp only [Nat.add_eq, Nat.sub_eq]
  omega

theorem vp_addBp (r : ℕ) : vp (Nat.add Bp r) = (r : ℝ) / 2 ^ 96 := by
  rw [vp_eq, Nat.add_eq, Nat.cast_add]; ring

theorem pabs_addBp (r : ℕ) : pabs (Nat.add Bp r) = r := by
  unfold pabs; simp only [Nat.add_eq, Nat.sub_eq]; omega

theorem vp_cst_pos (j : ℕ) : vp (Nat.add Bp (Nat.mul j ONE)) = (j : ℝ) := by
  rw [vp_addBp, Nat.mul_eq, Nat.cast_mul, cONE]; field_simp

theorem pabs_cst_pos (j : ℕ) : pabs (Nat.add Bp (Nat.mul j ONE)) = Nat.mul j ONE := pabs_addBp _

theorem vp_cst_neg {j : ℕ} (h : Nat.mul (Nat.succ j) ONE ≤ Bp) :
    vp (Nat.sub Bp (Nat.mul (Nat.succ j) ONE)) = -((j : ℝ) + 1) := by
  rw [vp_eq, show Nat.sub Bp (Nat.mul (Nat.succ j) ONE) = Bp - Nat.mul (Nat.succ j) ONE from rfl,
    Nat.cast_sub h, Nat.mul_eq, Nat.cast_mul, cONE, Nat.cast_succ]
  field_simp
  ring

theorem pabs_cst_neg {j : ℕ} (h : Nat.mul (Nat.succ j) ONE ≤ Bp) :
    pabs (Nat.sub Bp (Nat.mul (Nat.succ j) ONE)) = Nat.mul (Nat.succ j) ONE := by
  unfold pabs; simp only [Nat.add_eq, Nat.sub_eq] at *; omega

/-- a positive lower end -/
theorem posLo_spec {A : I} (h : posLo A = true) : ¬Nat.ble Bb A.L = true := by
  intro hc
  unfold posLo at h
  rw [hc] at h
  exact Bool.false_ne_true h

theorem sqrtDen_some {W V iv : I} (h : sqrtDen W V.sqrt = some iv) :
    ∃ s, V.sqrt = some s ∧ (s.add W).inv = some iv := by
  cases hs : V.sqrt with
  | none => rw [hs] at h; cases h
  | some s => rw [hs] at h; exact ⟨s, rfl, h⟩

end TF

/-! The constants are irreducible from here on: `whnf` of `Nat.sub e Bp` with a literal `Bp` would
unfold the recursion of `Nat.sub` `2^400` times. -/
attribute [local irreducible] Bb B2 ONE S2K RND C1 C2 C3 TF.Bp TF.Bp2 TF.DB TF.BpB TF.LIM TF.LIMA
  TF.K1 TF.K2 TF.M400

namespace TF.W4

/-- the last term of a sum is at most the sum -/
theorem le_lsum_last {a b : ℕ} : a ≤ b + a := Nat.le_add_left a b
/-- a bound below a left-nested sum survives one more term -/
theorem le_lsum_step {a b c : ℕ} (h : a ≤ b) : a ≤ b + c := le_trans h (Nat.le_add_right b c)

/-! ## `TF.W4` -/

/-- the constant part -/
def h0 (u : T) (_t : Fin 4 → ℝ) : ℝ := vp u.c0
/-- the homogeneous part of graded degree 1 -/
def h1 (u : T) (t : Fin 4 → ℝ) : ℝ :=
  vp u.c1 * (t 0) +
    vp u.c2 * (t 1) +
    vp u.c3 * (t 2)
/-- the homogeneous part of graded degree 2 -/
def h2 (u : T) (t : Fin 4 → ℝ) : ℝ :=
  vp u.c4 * (t 0 ^ 2) +
    vp u.c5 * (t 0 * t 1) +
    vp u.c6 * (t 0 * t 2) +
    vp u.c7 * (t 1 ^ 2) +
    vp u.c8 * (t 1 * t 2) +
    vp u.c9 * (t 2 ^ 2) +
    vp u.c10 * (t 3)
/-- the homogeneous part of graded degree 3 -/
def h3 (u : T) (t : Fin 4 → ℝ) : ℝ :=
  vp u.c11 * (t 0 ^ 3) +
    vp u.c12 * (t 0 ^ 2 * t 1) +
    vp u.c13 * (t 0 ^ 2 * t 2) +
    vp u.c14 * (t 0 * t 1 ^ 2) +
    vp u.c15 * (t 0 * t 1 * t 2) +
    vp u.c16 * (t 0 * t 2 ^ 2) +
    vp u.c17 * (t 0 * t 3) +
    vp u.c18 * (t 1 ^ 3) +
    vp u.c19 * (t 1 ^ 2 * t 2) +
    vp u.c20 * (t 1 * t 2 ^ 2) +
    vp u.c21 * (t 1 * t 3) +
    vp u.c22 * (t 2 ^ 3) +
    vp u.c23 * (t 2 * t 3)

/-- the polynomial of a model -/
def poly (u : T) (t : Fin 4 → ℝ) : ℝ := h0 u t + h1 u t + h2 u t + h3 u t

/-- `u` encloses `f` on the box -/
def Enc (f : (Fin 4 → ℝ) → ℝ) (u : T) : Prop :=
  u.ok = true → u.st = statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23 ∧
    pabs u.c0 + pabs u.c1 + pabs u.c2 + pabs u.c3 + pabs u.c4 + pabs u.c5 + pabs u.c6 + pabs u.c7 + pabs u.c8 + pabs u.c9 + pabs u.c10 + pabs u.c11 + pabs u.c12 + pabs u.c13 + pabs u.c14 + pabs u.c15 + pabs u.c16 + pabs u.c17 + pabs u.c18 + pabs u.c19 + pabs u.c20 + pabs u.c21 + pabs u.c22 + pabs u.c23 ≤ u.A ∧
    ∀ t, Box4 t → I.mem (f t - poly u t) u.R

theorem add_okeq (u v : T) : (add u v).ok = (u.ok && v.ok && Nat.ble (Nat.add u.A v.A) LIMA) := rfl
theorem sub_okeq (u v : T) : (sub u v).ok = (u.ok && v.ok && Nat.ble (Nat.add u.A v.A) LIMA) := rfl
theorem neg_okeq (u : T) : (neg u).ok = (u.ok && Nat.ble u.A LIMA) := rfl
theorem mul_okeq (u v : T) :
    (mul u v).ok = (u.ok && v.ok && Nat.ble u.st.as LIM && Nat.ble v.st.as LIM) := rfl
theorem sq_okeq (u : T) : (sq u).ok = (u.ok && Nat.ble u.st.as LIM) := rfl
theorem withR_okeq (u : T) (R : I) (ok : Bool) : (withR u R ok).ok = ok := rfl
theorem withR_Req (u : T) (R : I) (ok : Bool) : (withR u R ok).R = R := rfl
theorem posT_some (u : T) : posT (some u) = (u.ok && posLo (rng u)) := rfl

theorem as_eq (u : T) : (statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).as = pabs u.c0 + pabs u.c1 + pabs u.c2 + pabs u.c3 + pabs u.c4 + pabs u.c5 + pabs u.c6 + pabs u.c7 + pabs u.c8 + pabs u.c9 + pabs u.c10 + pabs u.c11 + pabs u.c12 + pabs u.c13 + pabs u.c14 + pabs u.c15 + pabs u.c16 + pabs u.c17 + pabs u.c18 + pabs u.c19 + pabs u.c20 + pabs u.c21 + pabs u.c22 + pabs u.c23 := by
  simp only [statsOf, pabs, Nat.add_eq]
  ring

theorem n1_eq (u : T) :
    ((statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).n1 : ℝ) = (pabs u.c1 : ℝ) + (pabs u.c2 : ℝ) + (pabs u.c3 : ℝ) := by
  simp only [statsOf, pabs, Nat.add_eq]
  push_cast
  ring

theorem h1_le (u : T) {t : Fin 4 → ℝ} (ht : Box4 t) :
    |h1 u t| ≤ ((statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).n1 : ℝ) / 2 ^ 96 := by
  rw [n1_eq]
  have b1 : |vp u.c1 * (t 0)| ≤ (pabs u.c1 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (ht 0)
  obtain ⟨l1, r1⟩ := abs_le.mp b1
  have b2 : |vp u.c2 * (t 1)| ≤ (pabs u.c2 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (ht 1)
  obtain ⟨l2, r2⟩ := abs_le.mp b2
  have b3 : |vp u.c3 * (t 2)| ≤ (pabs u.c3 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (ht 2)
  obtain ⟨l3, r3⟩ := abs_le.mp b3
  unfold h1
  rw [abs_le]
  constructor <;> linarith

theorem n2_eq (u : T) :
    ((statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).n2 : ℝ) = (pabs u.c4 : ℝ) + (pabs u.c5 : ℝ) + (pabs u.c6 : ℝ) + (pabs u.c7 : ℝ) + (pabs u.c8 : ℝ) + (pabs u.c9 : ℝ) + (pabs u.c10 : ℝ) := by
  simp only [statsOf, pabs, Nat.add_eq]
  push_cast
  ring

theorem h2_le (u : T) {t : Fin 4 → ℝ} (ht : Box4 t) :
    |h2 u t| ≤ ((statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).n2 : ℝ) / 2 ^ 96 := by
  rw [n2_eq]
  have b4 : |vp u.c4 * (t 0 ^ 2)| ≤ (pabs u.c4 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_pow_le_one (ht 0) 2)
  obtain ⟨l4, r4⟩ := abs_le.mp b4
  have b5 : |vp u.c5 * (t 0 * t 1)| ≤ (pabs u.c5 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 0) (ht 1))
  obtain ⟨l5, r5⟩ := abs_le.mp b5
  have b6 : |vp u.c6 * (t 0 * t 2)| ≤ (pabs u.c6 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 0) (ht 2))
  obtain ⟨l6, r6⟩ := abs_le.mp b6
  have b7 : |vp u.c7 * (t 1 ^ 2)| ≤ (pabs u.c7 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_pow_le_one (ht 1) 2)
  obtain ⟨l7, r7⟩ := abs_le.mp b7
  have b8 : |vp u.c8 * (t 1 * t 2)| ≤ (pabs u.c8 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 1) (ht 2))
  obtain ⟨l8, r8⟩ := abs_le.mp b8
  have b9 : |vp u.c9 * (t 2 ^ 2)| ≤ (pabs u.c9 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_pow_le_one (ht 2) 2)
  obtain ⟨l9, r9⟩ := abs_le.mp b9
  have b10 : |vp u.c10 * (t 3)| ≤ (pabs u.c10 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (ht 3)
  obtain ⟨l10, r10⟩ := abs_le.mp b10
  unfold h2
  rw [abs_le]
  constructor <;> linarith

theorem n3_eq (u : T) :
    ((statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).n3 : ℝ) = (pabs u.c11 : ℝ) + (pabs u.c12 : ℝ) + (pabs u.c13 : ℝ) + (pabs u.c14 : ℝ) + (pabs u.c15 : ℝ) + (pabs u.c16 : ℝ) + (pabs u.c17 : ℝ) + (pabs u.c18 : ℝ) + (pabs u.c19 : ℝ) + (pabs u.c20 : ℝ) + (pabs u.c21 : ℝ) + (pabs u.c22 : ℝ) + (pabs u.c23 : ℝ) := by
  simp only [statsOf, pabs, Nat.add_eq]
  push_cast
  ring

theorem h3_le (u : T) {t : Fin 4 → ℝ} (ht : Box4 t) :
    |h3 u t| ≤ ((statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23).n3 : ℝ) / 2 ^ 96 := by
  rw [n3_eq]
  have b11 : |vp u.c11 * (t 0 ^ 3)| ≤ (pabs u.c11 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_pow_le_one (ht 0) 3)
  obtain ⟨l11, r11⟩ := abs_le.mp b11
  have b12 : |vp u.c12 * (t 0 ^ 2 * t 1)| ≤ (pabs u.c12 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (abs_pow_le_one (ht 0) 2) (ht 1))
  obtain ⟨l12, r12⟩ := abs_le.mp b12
  have b13 : |vp u.c13 * (t 0 ^ 2 * t 2)| ≤ (pabs u.c13 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (abs_pow_le_one (ht 0) 2) (ht 2))
  obtain ⟨l13, r13⟩ := abs_le.mp b13
  have b14 : |vp u.c14 * (t 0 * t 1 ^ 2)| ≤ (pabs u.c14 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 0) (abs_pow_le_one (ht 1) 2))
  obtain ⟨l14, r14⟩ := abs_le.mp b14
  have b15 : |vp u.c15 * (t 0 * t 1 * t 2)| ≤ (pabs u.c15 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (abs_mul_le_one (ht 0) (ht 1)) (ht 2))
  obtain ⟨l15, r15⟩ := abs_le.mp b15
  have b16 : |vp u.c16 * (t 0 * t 2 ^ 2)| ≤ (pabs u.c16 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 0) (abs_pow_le_one (ht 2) 2))
  obtain ⟨l16, r16⟩ := abs_le.mp b16
  have b17 : |vp u.c17 * (t 0 * t 3)| ≤ (pabs u.c17 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 0) (ht 3))
  obtain ⟨l17, r17⟩ := abs_le.mp b17
  have b18 : |vp u.c18 * (t 1 ^ 3)| ≤ (pabs u.c18 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_pow_le_one (ht 1) 3)
  obtain ⟨l18, r18⟩ := abs_le.mp b18
  have b19 : |vp u.c19 * (t 1 ^ 2 * t 2)| ≤ (pabs u.c19 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (abs_pow_le_one (ht 1) 2) (ht 2))
  obtain ⟨l19, r19⟩ := abs_le.mp b19
  have b20 : |vp u.c20 * (t 1 * t 2 ^ 2)| ≤ (pabs u.c20 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 1) (abs_pow_le_one (ht 2) 2))
  obtain ⟨l20, r20⟩ := abs_le.mp b20
  have b21 : |vp u.c21 * (t 1 * t 3)| ≤ (pabs u.c21 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 1) (ht 3))
  obtain ⟨l21, r21⟩ := abs_le.mp b21
  have b22 : |vp u.c22 * (t 2 ^ 3)| ≤ (pabs u.c22 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_pow_le_one (ht 2) 3)
  obtain ⟨l22, r22⟩ := abs_le.mp b22
  have b23 : |vp u.c23 * (t 2 * t 3)| ≤ (pabs u.c23 : ℝ) / 2 ^ 96 := by
    rw [← abs_vp]; exact term_le (abs_mul_le_one (ht 2) (ht 3))
  obtain ⟨l23, r23⟩ := abs_le.mp b23
  unfold h3
  rw [abs_le]
  constructor <;> linarith

theorem prng_mem (u : T) (hs : u.st = statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23) {t : Fin 4 → ℝ} (ht : Box4 t) :
    I.mem (poly u t) (prng u) := by
  obtain ⟨o1l, o1h⟩ := odd_term u.c1 (m := t 0) (ht 0)
  obtain ⟨o2l, o2h⟩ := odd_term u.c2 (m := t 1) (ht 1)
  obtain ⟨o3l, o3h⟩ := odd_term u.c3 (m := t 2) (ht 2)
  obtain ⟨e4l, e4h⟩ := even_term u.c4 (m := t 0 ^ 2) (by positivity)
    (le_trans (le_abs_self _) (abs_pow_le_one (ht 0) 2))
  obtain ⟨o5l, o5h⟩ := odd_term u.c5 (m := t 0 * t 1) (abs_mul_le_one (ht 0) (ht 1))
  obtain ⟨o6l, o6h⟩ := odd_term u.c6 (m := t 0 * t 2) (abs_mul_le_one (ht 0) (ht 2))
  obtain ⟨e7l, e7h⟩ := even_term u.c7 (m := t 1 ^ 2) (by positivity)
    (le_trans (le_abs_self _) (abs_pow_le_one (ht 1) 2))
  obtain ⟨o8l, o8h⟩ := odd_term u.c8 (m := t 1 * t 2) (abs_mul_le_one (ht 1) (ht 2))
  obtain ⟨e9l, e9h⟩ := even_term u.c9 (m := t 2 ^ 2) (by positivity)
    (le_trans (le_abs_self _) (abs_pow_le_one (ht 2) 2))
  obtain ⟨o10l, o10h⟩ := odd_term u.c10 (m := t 3) (ht 3)
  obtain ⟨o11l, o11h⟩ := odd_term u.c11 (m := t 0 ^ 3) (abs_pow_le_one (ht 0) 3)
  obtain ⟨o12l, o12h⟩ := odd_term u.c12 (m := t 0 ^ 2 * t 1) (abs_mul_le_one (abs_pow_le_one (ht 0) 2) (ht 1))
  obtain ⟨o13l, o13h⟩ := odd_term u.c13 (m := t 0 ^ 2 * t 2) (abs_mul_le_one (abs_pow_le_one (ht 0) 2) (ht 2))
  obtain ⟨o14l, o14h⟩ := odd_term u.c14 (m := t 0 * t 1 ^ 2) (abs_mul_le_one (ht 0) (abs_pow_le_one (ht 1) 2))
  obtain ⟨o15l, o15h⟩ := odd_term u.c15 (m := t 0 * t 1 * t 2) (abs_mul_le_one (abs_mul_le_one (ht 0) (ht 1)) (ht 2))
  obtain ⟨o16l, o16h⟩ := odd_term u.c16 (m := t 0 * t 2 ^ 2) (abs_mul_le_one (ht 0) (abs_pow_le_one (ht 2) 2))
  obtain ⟨o17l, o17h⟩ := odd_term u.c17 (m := t 0 * t 3) (abs_mul_le_one (ht 0) (ht 3))
  obtain ⟨o18l, o18h⟩ := odd_term u.c18 (m := t 1 ^ 3) (abs_pow_le_one (ht 1) 3)
  obtain ⟨o19l, o19h⟩ := odd_term u.c19 (m := t 1 ^ 2 * t 2) (abs_mul_le_one (abs_pow_le_one (ht 1) 2) (ht 2))
  obtain ⟨o20l, o20h⟩ := odd_term u.c20 (m := t 1 * t 2 ^ 2) (abs_mul_le_one (ht 1) (abs_pow_le_one (ht 2) 2))
  obtain ⟨o21l, o21h⟩ := odd_term u.c21 (m := t 1 * t 3) (abs_mul_le_one (ht 1) (ht 3))
  obtain ⟨o22l, o22h⟩ := odd_term u.c22 (m := t 2 ^ 3) (abs_pow_le_one (ht 2) 3)
  obtain ⟨o23l, o23h⟩ := odd_term u.c23 (m := t 2 * t 3) (abs_mul_le_one (ht 2) (ht 3))
  have hv0 := vp_eq u.c0
  unfold prng
  rw [hs]
  simp only [statsOf]
  refine ⟨le_trans ?_ (val_sub_ge' _ _), le_trans ?_ (val_sub_ge' _ _)⟩
  · unfold poly h0 h1 h2 h3
    simp only [Nat.add_eq, Nat.cast_add, cBpB']
    linarith
  · unfold poly h0 h1 h2 h3
    simp only [Nat.add_eq, Nat.cast_add, cBpB']
