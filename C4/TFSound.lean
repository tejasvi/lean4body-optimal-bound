    (hR : ok = true → ∀ t, Box4 t → I.mem (f t - poly (mk c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 R A ok) t) R) :
    Enc f (mk c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 R A ok) := fun hok => ⟨rfl, hA hok, hR hok⟩

