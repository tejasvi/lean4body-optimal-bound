theorem inv_enc {f : (Fin 4 → ℝ) → ℝ} {v w : T} (hv : Enc f v) (h : inv v = some w) :
    Enc (fun t => (f t)⁻¹) w := by
  have hY := withR_enc (invSeries v)
  have hE := sub_enc (cst_enc 1) (mul_enc hv hY)
  unfold inv at h
  cases hiv : (rng v).inv with
  | none => rw [hiv] at h; cases h
  | some iv =>
    rw [hiv] at h
    simp only [resid, Option.some.injEq] at h
    subst h
    apply withR_enc'
    intro hok t ht
    simp only [Bool.and_eq_true] at hok
    obtain ⟨hov, hoE⟩ := hok
    obtain ⟨hsv, -, hRv⟩ := hv hov
    obtain ⟨hsE, -, hRE⟩ := hE hoE
    have fv := rng_mem hsv hRv ht
    obtain ⟨hf0, hfi⟩ := I.mem_inv fv hiv
    have fE := rng_mem hsE hRE ht
    rw [poly_withR]
    have key : (f t)⁻¹ - poly (invSeries v) t =
        (((1 : ℤ) : ℝ) - f t * poly (invSeries v) t) * (f t)⁻¹ := by
      have := inv_resid hf0 (poly (invSeries v) t)
      push_cast
      linarith
    rw [key]
    exact I.mem_mul fE hfi

