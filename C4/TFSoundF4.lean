theorem sq_enc {f : (Fin 4 → ℝ) → ℝ} {u : T} (hu : Enc f u) :
    Enc (fun t => f t ^ 2) (sq u) := by
  have e : (fun t => f t ^ 2) = (fun t => f t * f t) := by funext t; ring
  rw [e, sq_eq]
  exact mul_enc hu hu

theorem poly_withR (u : T) (R : I) (ok : Bool) (t : Fin 4 → ℝ) : poly (withR u R ok) t = poly u t := by
  simp only [poly, h0, h1, h2, h3, withR, mk]

theorem withR_enc' {g : (Fin 4 → ℝ) → ℝ} (u : T) (R : I) (ok : Bool)
    (h : ok = true → ∀ t, Box4 t → I.mem (g t - poly u t) R) : Enc g (withR u R ok) := by
  intro hok
  refine ⟨rfl, le_refl _, fun t ht => ?_⟩
  rw [poly_withR, withR_Req]
  exact h hok t ht

theorem withR_enc (u : T) : Enc (poly u) (withR u I.zero true) :=
  withR_enc' u I.zero true fun _ t _ => by rw [sub_self]; exact I.mem_zero

theorem withR_rng (u : T) {t : Fin 4 → ℝ} (ht : Box4 t) : I.mem (poly u t) (rng (withR u I.zero true)) := by
  have h1 := prng_mem (withR u I.zero true) rfl ht
  rw [poly_withR] at h1
  unfold rng
  rw [withR_Req]
  have := I.mem_add h1 I.mem_zero
  rwa [add_zero] at this

