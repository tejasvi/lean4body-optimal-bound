theorem sqrt_enc {f : (Fin 4 → ℝ) → ℝ} {v w : T} (hv : Enc f v) (h : sqrt v = some w) :
    Enc (fun t => Real.sqrt (f t)) w := by
  have hY := withR_enc (sqrtSeries v)
  have hE := sub_enc hv (mul_enc hY hY)
  unfold sqrt at h
  dsimp only at h
  cases hd : sqrtDen (rng (withR (sqrtSeries v) I.zero true)) (rng v).sqrt with
  | none => rw [hd] at h; cases h
  | some iv =>
    rw [hd] at h
    simp only [resid, Option.some.injEq] at h
    subst h
    obtain ⟨sv, hs, hiv⟩ := sqrtDen_some hd
    apply withR_enc'
    intro hok t ht
    simp only [Bool.and_eq_true] at hok
    obtain ⟨hov, hoE⟩ := hok
    obtain ⟨hsv, -, hRv⟩ := hv hov
    obtain ⟨hsE, -, hRE⟩ := hE hoE
    have fv := rng_mem hsv hRv ht
    obtain ⟨hf0, hfs⟩ := I.mem_sqrt fv hs
    have fY := withR_rng (sqrtSeries v) ht
    obtain ⟨hd0, hdi⟩ := I.mem_inv (I.mem_add hfs fY) hiv
    have fE := rng_mem hsE hRE ht
    rw [poly_withR]
    have key : Real.sqrt (f t) - poly (sqrtSeries v) t =
        (f t - poly (sqrtSeries v) t * poly (sqrtSeries v) t) *
          (Real.sqrt (f t) + poly (sqrtSeries v) t)⁻¹ := by
      have := sqrt_resid hf0 (poly (sqrtSeries v) t) hd0
      rw [pow_two] at this
      linarith
    rw [key]
    exact I.mem_mul fE hdi

