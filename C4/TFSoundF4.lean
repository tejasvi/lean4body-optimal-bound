@[expose] public section

/-!
# Soundness of the fixed-point Taylor models `TF.F4`

Generated by a script; the same generated lemmas as for `TF.W4` in `C4/TFSound.lean`, for one more
model type: `Enc`, the statistics, `add`/`sub`/`neg`, the constants and coordinates, `mul`/`sq` by
per-degree identities, `inv`/`sqrt`/`div` by residuals, `ops_sound`, `posT_spec` and `newtOK_spec`,
which are the fields of `TFSoundK`.
-/

set_option exponentiation.threshold 1024

namespace C4

noncomputable section

/-! The constants are irreducible here: `whnf` of `Nat.sub e Bp` with a literal `Bp` would
unfold the recursion of `Nat.sub` `2^400` times. -/
attribute [local irreducible] Bb B2 ONE S2K RND C1 C2 C3 TF.Bp TF.Bp2 TF.DB TF.BpB TF.LIM TF.LIMA
  TF.K1 TF.K2 TF.M400

namespace TF.F4

/-- the last term of a sum is at most the sum -/
theorem le_lsum_last {a b : ℕ} : a ≤ b + a := Nat.le_add_left a b
/-- a bound below a left-nested sum survives one more term -/
theorem le_lsum_step {a b c : ℕ} (h : a ≤ b) : a ≤ b + c := le_trans h (Nat.le_add_right b c)

/-! ## `TF.F4` -/

/-- the constant part -/
def h0 (u : T) (_t : Fin 4 → ℝ) : ℝ := vp u.c0
/-- the homogeneous part of graded degree 1 -/
def h1 (u : T) (t : Fin 4 → ℝ) : ℝ :=
  vp u.c1 * (t 0) +
    vp u.c2 * (t 1) +
    vp u.c3 * (t 2) +
    vp u.c4 * (t 3)
/-- the homogeneous part of graded degree 2 -/
def h2 (u : T) (t : Fin 4 → ℝ) : ℝ :=
  vp u.c5 * (t 0 ^ 2) +
    vp u.c6 * (t 0 * t 1) +
    vp u.c7 * (t 0 * t 2) +
    vp u.c8 * (t 0 * t 3) +
    vp u.c9 * (t 1 ^ 2) +
    vp u.c10 * (t 1 * t 2) +
    vp u.c11 * (t 1 * t 3) +
    vp u.c12 * (t 2 ^ 2) +
    vp u.c13 * (t 2 * t 3) +
    vp u.c14 * (t 3 ^ 2)
/-- the homogeneous part of graded degree 3 -/
def h3 (u : T) (t : Fin 4 → ℝ) : ℝ :=
  vp u.c15 * (t 0 ^ 3) +
    vp u.c16 * (t 0 ^ 2 * t 1) +
    vp u.c17 * (t 0 ^ 2 * t 2) +
    vp u.c18 * (t 0 ^ 2 * t 3) +
    vp u.c19 * (t 0 * t 1 ^ 2) +
    vp u.c20 * (t 0 * t 1 * t 2) +
    vp u.c21 * (t 0 * t 1 * t 3) +
    vp u.c22 * (t 0 * t 2 ^ 2) +
    vp u.c23 * (t 0 * t 2 * t 3) +
    vp u.c24 * (t 0 * t 3 ^ 2) +
    vp u.c25 * (t 1 ^ 3) +
    vp u.c26 * (t 1 ^ 2 * t 2) +
    vp u.c27 * (t 1 ^ 2 * t 3) +
    vp u.c28 * (t 1 * t 2 ^ 2) +
    vp u.c29 * (t 1 * t 2 * t 3) +
    vp u.c30 * (t 1 * t 3 ^ 2) +
    vp u.c31 * (t 2 ^ 3) +
    vp u.c32 * (t 2 ^ 2 * t 3) +
    vp u.c33 * (t 2 * t 3 ^ 2) +
    vp u.c34 * (t 3 ^ 3)

/-- the polynomial of a model -/
def poly (u : T) (t : Fin 4 → ℝ) : ℝ := h0 u t + h1 u t + h2 u t + h3 u t

/-- `u` encloses `f` on the box -/
def Enc (f : (Fin 4 → ℝ) → ℝ) (u : T) : Prop :=
  u.ok = true → u.st = statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23 u.c24 u.c25 u.c26 u.c27 u.c28 u.c29 u.c30 u.c31 u.c32 u.c33 u.c34 ∧
    pabs u.c0 + pabs u.c1 + pabs u.c2 + pabs u.c3 + pabs u.c4 + pabs u.c5 + pabs u.c6 + pabs u.c7 + pabs u.c8 + pabs u.c9 + pabs u.c10 + pabs u.c11 + pabs u.c12 + pabs u.c13 + pabs u.c14 + pabs u.c15 + pabs u.c16 + pabs u.c17 + pabs u.c18 + pabs u.c19 + pabs u.c20 + pabs u.c21 + pabs u.c22 + pabs u.c23 + pabs u.c24 + pabs u.c25 + pabs u.c26 + pabs u.c27 + pabs u.c28 + pabs u.c29 + pabs u.c30 + pabs u.c31 + pabs u.c32 + pabs u.c33 + pabs u.c34 ≤ u.A ∧
    ∀ t, Box4 t → I.mem (f t - poly u t) u.R

theorem add_okeq (u v : T) : (add u v).ok = (u.ok && v.ok && Nat.ble (Nat.add u.A v.A) LIMA) := rfl
theorem sub_okeq (u v : T) : (sub u v).ok = (u.ok && v.ok && Nat.ble (Nat.add u.A v.A) LIMA) := rfl
theorem neg_okeq (u : T) : (neg u).ok = (u.ok && Nat.ble u.A LIMA) := rfl
theorem mul_okeq (u v : T) :
    (mul u v).ok = (u.ok && v.ok && Nat.ble u.st.as LIM && Nat.ble v.st.as LIM) := rfl
theorem sq_okeq (u : T) : (sq u).ok = (u.ok && Nat.ble u.st.as LIM) := rfl
theorem withR_okeq (u : T) (R : I) (ok : Bool) : (withR u R ok).ok = ok := rfl
theorem withR_Req (u : T) (R : I) (ok : Bool) : (withR u R ok).R = R := rfl
theorem posT_some (u : T) : posT (some u) = (u.ok && posLo (rng u)) := rfl

