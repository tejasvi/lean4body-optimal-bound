theorem prng_mem (u : T) (hs : u.st = statsOf u.c0 u.c1 u.c2 u.c3 u.c4 u.c5 u.c6 u.c7 u.c8 u.c9 u.c10 u.c11 u.c12 u.c13 u.c14 u.c15 u.c16 u.c17 u.c18 u.c19 u.c20 u.c21 u.c22 u.c23 u.c24 u.c25 u.c26 u.c27 u.c28 u.c29 u.c30 u.c31 u.c32 u.c33 u.c34) {t : Fin 4 → ℝ} (ht : Box4 t) :
    I.mem (poly u t) (prng u) := by
  obtain ⟨o1l, o1h⟩ := odd_term u.c1 (m := t 0) (ht 0)
  obtain ⟨o2l, o2h⟩ := odd_term u.c2 (m := t 1) (ht 1)
  obtain ⟨o3l, o3h⟩ := odd_term u.c3 (m := t 2) (ht 2)
  obtain ⟨o4l, o4h⟩ := odd_term u.c4 (m := t 3) (ht 3)
  obtain ⟨e5l, e5h⟩ := even_term u.c5 (m := t 0 ^ 2) (by positivity)
    (le_trans (le_abs_self _) (abs_pow_le_one (ht 0) 2))
  obtain ⟨o6l, o6h⟩ := odd_term u.c6 (m := t 0 * t 1) (abs_mul_le_one (ht 0) (ht 1))
  obtain ⟨o7l, o7h⟩ := odd_term u.c7 (m := t 0 * t 2) (abs_mul_le_one (ht 0) (ht 2))
  obtain ⟨o8l, o8h⟩ := odd_term u.c8 (m := t 0 * t 3) (abs_mul_le_one (ht 0) (ht 3))
  obtain ⟨e9l, e9h⟩ := even_term u.c9 (m := t 1 ^ 2) (by positivity)
