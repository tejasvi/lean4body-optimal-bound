theorem div_some {u v w : T} (h : div u v = some w) : ∃ iv, inv v = some iv ∧ w = mul u iv := by
  obtain ⟨iv, hiv, e⟩ := Option.map_eq_some_iff.mp h
  exact ⟨iv, hiv, e.symm⟩

theorem div_enc {f g : (Fin 4 → ℝ) → ℝ} {u v w : T} (hu : Enc f u) (hv : Enc g v)
    (h : div u v = some w) : Enc (fun t => f t / g t) w := by
  obtain ⟨iv, hiv, rfl⟩ := div_some h
  have e : (fun t => f t / g t) = (fun t => f t * (g t)⁻¹) := by funext t; ring
  rw [e]
  exact mul_enc hu (inv_enc hv hiv)

/-- the operations of `tfOps` are sound -/
theorem ops_sound : OpsSound (Fin 4 → ℝ) T Enc where
  add f g x y hx hy := by
    cases x with
    | none => cases y <;> exact OEncG.none
    | some a =>
      cases y with
      | none => exact OEncG.none
      | some b => exact OEncG.of_some (add_enc (hx _ rfl) (hy _ rfl))
  sub f g x y hx hy := by
    cases x with
    | none => cases y <;> exact OEncG.none
    | some a =>
      cases y with
      | none => exact OEncG.none
      | some b => exact OEncG.of_some (sub_enc (hx _ rfl) (hy _ rfl))
  mul f g x y hx hy := by
    cases x with
    | none => cases y <;> exact OEncG.none
    | some a =>
      cases y with
      | none => exact OEncG.none
      | some b => exact OEncG.of_some (mul_enc (hx _ rfl) (hy _ rfl))
  div f g x y hx hy := by
    cases x with
    | none => cases y <;> exact OEncG.none
    | some a =>
      cases y with
      | none => exact OEncG.none
      | some b => exact fun w hw => div_enc (hx _ rfl) (hy _ rfl) hw
  neg f x hx := by
    cases x with
    | none => exact OEncG.none
    | some a => exact OEncG.of_some (neg_enc (hx _ rfl))
  sqrt f x hx := by
    cases x with
    | none => exact OEncG.none
    | some a => exact fun w hw => sqrt_enc (hx _ rfl) hw
  sq f x hx := by
    cases x with
    | none => exact OEncG.none
    | some a => exact OEncG.of_some (sq_enc (hx _ rfl))
  ofInt n := OEncG.of_some (cst_enc n)

